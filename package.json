{
  "name": "svelte-aplayer",
  "version": "0.1.2",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:wc && npm run build:svelte && npm run build:types && npm run test:types",
    "build:wc": "cross-env CUSTOM_ELEMENT=1 vite build",
    "build:svelte": "cross-env CUSTOM_ELEMENT=0 vite build",
    "build:types": "tsc -p tsconfig.build-types.json",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "prepare": "simple-git-hooks",
    "serve": "vite preview",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:types": "svelte-check --tsconfig ./tests/types/tsconfig.json"
  },
  "license": "MIT",
  "browser": "dist/wc/svelte-aplayer.umd.js",
  "module": "dist/wc/svelte-aplayer.es.js",
  "homepage": "https://github.com/fengkx/svelte-aplayer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fengkx/svelte-aplayer.git"
  },
  "files": [
    "dist/**/*"
  ],
  "keywords": [
    "player",
    "aplayer",
    "svelte",
    "webcomponent",
    "component"
  ],
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^26.1.2",
    "cross-env": "^10.1.0",
    "pkg-pr-new": "^0.0.82",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "sass": "^1.102.0",
    "simple-git-hooks": "^2.13.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run format"
  }
}
